<Window x:Class="ProfileOnPC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки ProfileOnPC"
        Width="560"
        Height="700"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="0" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Настройки" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Изменения оформления отображаются сразу."
                       Style="{StaticResource SecondaryTextStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Оформление" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Тема" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,5"/>
                        <ComboBox x:Name="ThemeBox"
                                  SelectionChanged="Appearance_OnSelectionChanged">
                            <ComboBoxItem Content="Темная" Tag="Dark"/>
                            <ComboBoxItem Content="Светлая" Tag="Light"/>
                        </ComboBox>

                        <TextBlock Text="Акцентный цвет"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,14,0,5"/>
                        <ComboBox x:Name="AccentBox"
                                  SelectionChanged="Appearance_OnSelectionChanged">
                            <ComboBoxItem Content="Сдержанный синий" Tag="#2563A6"/>
                            <ComboBoxItem Content="Серый" Tag="#64748B"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Поведение" Style="{StaticResource SectionTitleStyle}"/>
                        <CheckBox x:Name="AutorunCheck" Content="Запускать вместе с Windows"/>

                        <TextBlock Text="При закрытии окна"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,10,0,5"/>
                        <ComboBox x:Name="CloseActionBox">
                            <ComboBoxItem Content="Сворачивать в трей" Tag="tray"/>
                            <ComboBoxItem Content="Сворачивать на панель задач" Tag="minimize"/>
                            <ComboBoxItem Content="Закрывать приложение" Tag="exit"/>
                        </ComboBox>

                        <CheckBox x:Name="ApplyOnStartupCheck"
                                  Content="Применять активный профиль при запуске"/>

                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="Если иконка в трее скрыта в области «^» рядом с часами, запустите ProfileOnPC.exe ещё раз — окно откроется."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Фон и автоматизация" Style="{StaticResource SectionTitleStyle}"/>
                        <CheckBox x:Name="HotkeysCheck"
                                  Content="Глобальные горячие клавиши для смены профилей"/>
                        <CheckBox x:Name="TriggersCheck"
                                  Content="Авто-активация профиля по запуску приложений"/>
                        <CheckBox x:Name="ToastCheck"
                                  Content="Уведомление в трее после активации профиля"/>
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="Горячие клавиши и триггеры работают, пока приложение запущено, в том числе свернутым в трей."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Отмена" Width="105" Margin="0,0,8,0" Click="Cancel_OnClick"/>
            <Button Content="Сохранить"
                    Width="120"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_OnClick"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
