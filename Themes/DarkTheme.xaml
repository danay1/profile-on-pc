<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#F5F6F8</Color>
    <Color x:Key="SidebarBackgroundColor">#ECEEF1</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F2F4F6</Color>
    <Color x:Key="InputColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D9DDE3</Color>
    <Color x:Key="TextColor">#20242A</Color>
    <Color x:Key="SecondaryTextColor">#66707C</Color>
    <Color x:Key="DangerColor">#E5484D</Color>
    <Color x:Key="SuccessColor">#30A46C</Color>
    <Color x:Key="AccentColor">#2563A6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource InputColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3478B8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F568A"/>
</ResourceDictionary>

