<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#F5F7FA</Color>
    <Color x:Key="SidebarBackgroundColor">#EDF1F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F1F4F8</Color>
    <Color x:Key="InputColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D7DEE7</Color>
    <Color x:Key="TextColor">#17202A</Color>
    <Color x:Key="SecondaryTextColor">#667382</Color>
    <Color x:Key="DangerColor">#D9363E</Color>
    <Color x:Key="SuccessColor">#218A5A</Color>
    <Color x:Key="AccentColor">#0078D4</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource InputColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1688DD"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#006CBD"/>
</ResourceDictionary>
